{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Memory Manager",
  "mainBinaryName": "ai-memory-manager",
  "version": "0.1.0",
  "identifier": "com.lucasmonteir0.aimemorymanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AI Memory Manager",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "lucasmonteir0",
    "shortDescription": "Gerenciador gráfico do ai-memory",
    "longDescription": "Detecta, instala, diagnostica e integra o ai-memory com Claude Desktop (Code), Codex Desktop e Cursor no Windows.",
    "copyright": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR", "English"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI1MDBGQ0E5NEM3OEUxM0QKUldROTRYaE1xZndBdFRXbVhnNTFsRjArK1ZsOFFwUHEvdzd3YWxlUk03VVQ3SkdRRi9BOWp1UFYK",
      "endpoints": [
        "https://github.com/lucasmonteir0/ai-memory-manager/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
